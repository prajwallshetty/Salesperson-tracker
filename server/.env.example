DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salesforce_db?schema=public"
JWT_SECRET="change-me-in-production"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Razorpay - use TEST MODE keys (from the Razorpay dashboard's "Test Mode" toggle) while
# developing, and separate LIVE MODE keys in production. Never mix the two, never commit real
# values here, and never expose KEY_SECRET/WEBHOOK_SECRET to a browser - only RAZORPAY_KEY_ID is
# ever safe to send to a frontend (Razorpay Checkout needs it client-side).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the webhook's settings page in the Razorpay dashboard (Settings -> Webhooks) - a
# different secret than KEY_SECRET, used only to verify webhook payloads.
RAZORPAY_WEBHOOK_SECRET=
