# Backend API - only used server-side here (the public plans fetch), never exposed to a
# browser request from this app, but NEXT_PUBLIC_* so it can be read at build/runtime like the
# other two frontends.
NEXT_PUBLIC_API_URL=https://api.salesgrid.live

# Where "Log in" / "Get Started" / "Start Free Trial" link to - the actual admin/tenant app.
NEXT_PUBLIC_APP_URL=https://app.salesgrid.live

# Where a salesperson-specific link (if ever added) would point - kept separate from
# NEXT_PUBLIC_APP_URL since salesperson login (access code) must never be conflated with
# admin/tenant login (email+password).
NEXT_PUBLIC_SALES_URL=https://sales.salesgrid.live
