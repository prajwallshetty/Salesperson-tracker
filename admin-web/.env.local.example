## Base URL of the Express/Socket.IO backend (server/). This is safe to expose to the
## browser (no secrets), which is why it uses the NEXT_PUBLIC_ prefix. Never put DB
## credentials, JWT secrets, or other private keys in a NEXT_PUBLIC_ variable — those stay
## in server/.env only.
NEXT_PUBLIC_API_URL=http://localhost:4000

## MapTiler API key, used by MapLibre GL JS for map tiles/style on the live tracking map,
## its dashboard preview, and route history. Get a free key at https://cloud.maptiler.com/account/keys/
## — MapTiler keys are meant to be used client-side (restrict them to your domain(s) in
## the MapTiler dashboard for extra safety); this is not a private/secret credential, which
## is why it's safe behind the NEXT_PUBLIC_ prefix. Never put DB credentials or JWT
## secrets in a NEXT_PUBLIC_ variable — those stay in server/.env only.
## Without this set, the map shows a clear "Unable to load map" message instead of crashing.
NEXT_PUBLIC_MAPTILER_KEY=
