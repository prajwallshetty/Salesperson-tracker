## Base URL of the Express/Socket.IO backend (server/). This is safe to expose to the
## browser (no secrets), which is why it uses the NEXT_PUBLIC_ prefix. Never put DB
## credentials, JWT secrets, or other private keys in a NEXT_PUBLIC_ variable — those stay
## in server/.env only.
NEXT_PUBLIC_API_URL=http://localhost:4000

## Mapbox GL JS public access token (starts with "pk."), used by the live tracking map,
## its dashboard preview, and route history. Get one at https://account.mapbox.com/access-tokens/
## — Mapbox's public "pk." tokens are designed to be used client-side (they can be scoped
## to specific URLs in the Mapbox dashboard for extra safety) and are NOT the same as a
## private "sk." secret token, which must never appear here or anywhere client-side.
## Without this set, the map shows a clear "Map unavailable" message instead of crashing.
NEXT_PUBLIC_MAPBOX_TOKEN=
