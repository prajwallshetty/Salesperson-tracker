## Base URL of the Express/Socket.IO backend (server/). This is safe to expose to the
## browser (no secrets), which is why it uses the NEXT_PUBLIC_ prefix. Never put DB
## credentials, JWT secrets, or other private keys in a NEXT_PUBLIC_ variable — those stay
## in server/.env only.
NEXT_PUBLIC_API_URL=http://localhost:4000

## No map API key is required. The live tracking map (lib/maps/basemap.ts) uses raw
## OpenStreetMap raster tiles — no signup, no key, no account. If a nicer vector basemap
## is wanted later (CARTO, MapTiler, Mapbox), the tile source is centralized in that one
## file, so switching providers is a one-line change there rather than a rewrite.
